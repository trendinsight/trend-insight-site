// ⛔ 이 설정으로 `wrangler deploy` 를 직접 실행하지 마세요.
//    배포는 main 커밋 → Cloudflare Workers Builds 자동 배포로만 합니다.
//    assets.directory 가 "." 이므로 저장소 전체 파일이 없는 디렉터리에서 배포하면
//    프로덕션 애셋 번들이 반쪽짜리로 교체되어 사이트 전 페이지가 404 가 됩니다.
//    (worker.js 가 빠지면 /api/*, KV 기반 /data/*.json 도 함께 죽습니다)
//    사고 이력 2026-07-31 → 복구: 대시보드 > 배포 > 직전 main 빌드 버전 롤백
//    자세한 내용은 DEPLOY.md 참고.
{
  "name": "trend-insight-site",
  "main": "worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  // AI Gateway 바인딩 — Worker→Anthropic 직결이 403 으로 막혀 우회 경로로 사용
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "GAUGE_KV", "id": "7e25f0908b2f4a08b715b8736f859ec8" }
  ],
  "d1_databases": [
    { "binding": "RISK_DB", "database_name": "risk-manager", "database_id": "f08a8f96-b737-4674-80d4-79eb4c7e6ec1" },
    // Trend Insight AI 통합 두뇌 (정본). /api/chat 이 읽기 전용으로만 접근한다.
    { "binding": "BRAIN_DB", "database_name": "ti-brain", "database_id": "e0730895-8a74-4391-a368-63e642e9890d" }
  ],
  "triggers": {
    // 04:00 UTC(13:00 KST) 평일: 손절 장중 스캔 / 07:00 UTC(16:00 KST) 매일: 시장(평일)·코인(매일) 온도계 + 손절 종가 스캔(평일)
    "crons": ["0 4 * * 1-5", "0 7 * * *"]
  }
}
